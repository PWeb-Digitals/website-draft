# Copy to .env.local (never commit .env.local). The same names go in Netlify > Site settings > Environment variables.

# Sanity (blog, portfolio, templates). The project ID is not a secret.
NEXT_PUBLIC_SANITY_PROJECT_ID=n553kwl5
NEXT_PUBLIC_SANITY_DATASET=production
# Must match the secret in the Sanity webhook URL. Make it long and random.
REVALIDATION_SECRET=

# Forms: every form posts here. n8n adds the contact to Kit with a tag, runs the audit and pings Telegram.
LEAD_WEBHOOK_URL=

# Email copy of every lead (Gmail app password: myaccount.google.com/apppasswords)
GMAIL_USER=pwebsdigitals@gmail.com
GMAIL_APP_PASSWORD=

# Instagram section on the homepage (official Instagram API, long-lived token). Leave empty to hide it.
INSTAGRAM_ACCESS_TOKEN=

# Templates: used only until templates are added in Sanity
NEXT_PUBLIC_RESTAURANT_DEMO_URL=
NEXT_PUBLIC_RESTAURANT_PAYMENT_URL=

# Analytics (optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=
